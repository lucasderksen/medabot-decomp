Reload-debug agbcc: prints every round-robin reload-register choice
(reload1.c allocate_reload_reg) to stderr when AGBCC_RELOAD_DEBUG=1.
Output code is identical to tools/downloads/agbcc/agbcc.exe.
Build steps: docs/IDIOMS.md, section "Reload-debug agbcc".

--- a/gcc/reload1.c
+++ b/gcc/reload1.c
@@ -5195,6 +5195,8 @@
 	  {
 	    /* The reg is OK.  */
 	    last_spill_reg = i;
+	    if (getenv ("AGBCC_RELOAD_DEBUG"))
+	      fprintf (stderr, "ALLOC insn=%d reload=%d reg=%d n_spills=%d pass=%d\n", INSN_UID (chain->insn), r, regno, n_spills, pass);
 
 	    /* Mark as in use for this insn the reload regs we use
 	       for this.  */
